{
  "name": "taro_template",
  "version": "1.0.0",
  "private": true,
  "main": "desktop/main.cjs",
  "description": "taro_template",
  "templateInfo": {
    "name": "react",
    "typescript": true,
    "css": "Sass",
    "framework": "React"
  },
  "scripts": {
    "build:weapp": "taro build --type weapp",
    "build:swan": "taro build --type swan",
    "build:alipay": "taro build --type alipay",
    "build:tt": "taro build --type tt",
    "build:h5": "taro build --type h5",
    "build:rn": "taro build --type rn",
    "build:qq": "taro build --type qq",
    "build:jd": "taro build --type jd",
    "build:quickapp": "taro build --type quickapp",
    "dev:weapp": "npm run build:weapp -- --watch",
    "dev:swan": "npm run build:swan -- --watch",
    "dev:alipay": "npm run build:alipay -- --watch",
    "dev:tt": "npm run build:tt -- --watch",
    "dev:h5": "npm run build:h5 -- --watch",
    "dev:rn": "npm run build:rn -- --watch",
    "dev:qq": "npm run build:qq -- --watch",
    "dev:jd": "npm run build:jd -- --watch",
    "dev:quickapp": "npm run build:quickapp -- --watch",
    "build:android": "powershell -NoProfile -Command \"$env:TARO_PUBLIC_PATH='./'; npm run build:h5\" && powershell -NoProfile -Command \"powershell -NoProfile -ExecutionPolicy Bypass -File scripts\\sync-native-assets.ps1\" && cap sync android && cd android && gradlew.bat assembleRelease",
    "build:windows": "powershell -NoProfile -Command \"$env:TARO_PUBLIC_PATH='./'; npm run build:h5\" && powershell -NoProfile -Command \"powershell -NoProfile -ExecutionPolicy Bypass -File scripts\\sync-native-assets.ps1\" && electron-builder --win nsis",
    "test:backend": "node --test backend/*.test.cjs",
    "test:artifacts": "node --test tests/*.test.cjs",
    "test:browser": "node tests/navigation-browser.cjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src backend tests --ext .ts,.tsx,.js,.cjs",
    "verify:fast": "npm run typecheck && npm run lint && npm run test:backend && npm run test:artifacts",
    "verify:release-artifacts": "node scripts/verify-release-artifacts.cjs",
    "verify:release": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts\\verify-release.ps1"
  },
  "browserslist": [
    "last 3 versions",
    "Android >= 4.1",
    "ios >= 8"
  ],
  "author": "",
  "dependencies": {
    "@babel/runtime": "^7.21.5",
    "@capacitor/android": "^6.2.2",
    "@capacitor/cli": "^6.2.2",
    "@capacitor/core": "^6.2.2",
    "@capacitor/ios": "^6.2.2",
    "@capgo/capacitor-updater": "^6.51.15",
    "@tarojs/components": "4.2.1",
    "@tarojs/helper": "4.2.1",
    "@tarojs/plugin-framework-react": "4.2.1",
    "@tarojs/plugin-html": "4.2.1",
    "@tarojs/plugin-platform-alipay": "4.2.1",
    "@tarojs/plugin-platform-h5": "4.2.1",
    "@tarojs/plugin-platform-tt": "4.2.1",
    "@tarojs/plugin-platform-weapp": "4.2.1",
    "@tarojs/react": "4.2.1",
    "@tarojs/runtime": "4.2.1",
    "@tarojs/shared": "4.2.1",
    "@tarojs/taro": "4.2.1",
    "ajv": "^8.20.0",
    "classnames": "^2.5.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "build": {
    "appId": "com.warehouse.app.desktop",
    "productName": "閺囨瑥鍘滄惔鎾崇摠",
    "directories": {
      "output": "release/windows"
    },
    "files": [
      "desktop/**/*",
      "www/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  },
  "devDependencies": {
    "@babel/core": "^7.8.0",
    "@babel/plugin-proposal-class-properties": "7.14.5",
    "@babel/preset-react": "^7.24.1",
    "@playwright/test": "^1.63.0",
    "@pmmmwh/react-refresh-webpack-plugin": "^0.5.5",
    "@tarojs/cli": "4.2.1",
    "@tarojs/taro-loader": "4.2.1",
    "@tarojs/webpack5-runner": "4.2.1",
    "@types/node": "^18.15.11",
    "@types/react": "^18.0.0",
    "@types/webpack-env": "^1.13.6",
    "@typescript-eslint/eslint-plugin": "^6.2.0",
    "@typescript-eslint/parser": "^6.2.0",
    "babel-plugin-import": "^1.13.8",
    "babel-preset-taro": "4.2.1",
    "bplist-parser": "^0.5.0",
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3",
    "eslint": "^8.12.0",
    "eslint-config-taro": "4.2.1",
    "eslint-plugin-import": "^2.12.0",
    "eslint-plugin-react": "^7.8.2",
    "eslint-plugin-react-hooks": "^4.2.0",
    "minidev": "^2.2.5",
    "miniprogram-ci": "^2.1.26",
    "plist": "^5.0.0",
    "postcss": "^8.4.18",
    "react-refresh": "^0.14.2",
    "stylelint": "^14.4.0",
    "ts-node": "^10.9.1",
    "tsconfig-paths-webpack-plugin": "^4.0.1",
    "tt-ide-cli": "^0.1.31",
    "typescript": "^5.1.0",
    "webpack": "5.91.0",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1"
  }
}
